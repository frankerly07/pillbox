rules_version = '2';
// Who can see what:
//  - A patient owns patients/{their uid} and everything under it.
//  - A caregiver can read and write a patient's data once linked (their uid is in `caregivers`).
//  - A caregiver links by presenting a valid, unexpired 6-digit code the patient created.
service cloud.firestore {
  match /databases/{database}/documents {
    function authed() { return request.auth != null; }
    function patient(pid) { return get(/databases/$(database)/documents/patients/$(pid)).data; }
    function member(pid) {
      let p = patient(pid);
      return authed() && (request.auth.uid == p.ownerUid || request.auth.uid in p.caregivers);
    }

    match /users/{uid} {
      allow read, write: if authed() && request.auth.uid == uid;
    }

    match /linkCodes/{code} {
      allow get: if authed();
      allow create, update: if authed() && request.resource.data.patientId == request.auth.uid;
      allow delete: if authed() && resource.data.patientId == request.auth.uid;
    }

    match /patients/{pid} {
      allow create: if authed() && pid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.caregivers.size() == 0;
      allow read: if authed() && (resource.data.ownerUid == request.auth.uid || request.auth.uid in resource.data.caregivers);
      allow update: if authed() && (
        // the patient
        resource.data.ownerUid == request.auth.uid
        // a linked caregiver: can edit details but not who is linked (except removing themselves)
        || (request.auth.uid in resource.data.caregivers
            && request.resource.data.ownerUid == resource.data.ownerUid
            && (request.resource.data.caregivers == resource.data.caregivers
                || resource.data.caregivers.removeAll([request.auth.uid]) == request.resource.data.caregivers))
        // a new caregiver joining with the current code
        || (!(request.auth.uid in resource.data.caregivers)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caregivers', 'caregiverNames', 'joinCode'])
            && request.resource.data.joinCode == resource.data.linkCode
            && resource.data.linkCodeExpires > request.time.toMillis()
            && request.resource.data.caregivers.removeAll([request.auth.uid]) == resource.data.caregivers
            && request.auth.uid in request.resource.data.caregivers)
      );

      match /{sub}/{id} {
        allow read, write: if (sub == "meds" || sub == "doses" || sub == "stock") && member(pid);
      }
    }
  }
}
